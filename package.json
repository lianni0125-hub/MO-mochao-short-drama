{
  "name": "ai-short-drama-writer",
  "version": "1.2.9",
  "private": true,
  "type": "module",
  "description": "本地优先的 AI 短剧自动编剧工作台",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:autodl": "bash scripts/autodl-start.sh",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "test": "node --test --test-concurrency=1",
    "update:sources": "node src/jobs/update-sources.js"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "express": "^5.1.0",
    "iframe-resizer": "4.3.11",
    "jsonrepair": "^3.15.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "openai": "^5.20.3",
    "rss-parser": "^3.13.0"
  }
}
